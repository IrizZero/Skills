<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reports</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Reports</a>
            <ul class="navbar-nav flex-row">
                <li class="nav-item"><a class="nav-link" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-action="Reports">Reports</a></li>
            </ul>
        </div>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
</body>
</html>
