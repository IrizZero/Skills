{
  "env": {
    "OBSIDIAN_VAULT_PATH": "C:\\Vault\\Second_Brain"
  },
  "permissions": {
    "allow": [
      "mcp__serena__list_memories"
    ],
    "additionalDirectories": [
      "C:\\Vault\\Second_Brain"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "node \"C:/Users/amierashraf.hadi/.claude/statusline.js\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "obsidian-second-brain@obsidian-second-brain": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/JuliusBrussee/caveman.git"
      }
    },
    "obsidian-second-brain": {
      "source": {
        "source": "git",
        "url": "https://github.com/eugeniughelbur/obsidian-second-brain.git"
      }
    }
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/Users/amierashraf.hadi/.claude/hooks/guard.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "general-purpose|claude|Plan",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/Users/amierashraf.hadi/.claude/hooks/serena-notice.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}